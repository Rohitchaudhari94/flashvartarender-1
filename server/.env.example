PORT=5000

# MongoDB Atlas connection string. If your password contains special characters
# (@ : / ? # %) URL-encode them, e.g. "@" becomes "%40".
MONGO_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster>.mongodb.net/flashvarta?retryWrites=true&w=majority&appName=Cluster0

# Long random string used to sign JWT authentication tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# NewsData.io API key for live external headlines (https://newsdata.io)
NEWSDATA_API_KEY=pub_xxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# FlashVarta Primary Administrator Configuration
# Automatically initialized and protected on server start or via `npm run seed:admin`
# ==============================================================================
PRIMARY_ADMIN_IDENTIFIER=admin@123
PRIMARY_ADMIN_NAME=Rohit Chaudhari (Primary Admin)
PRIMARY_ADMIN_EMAIL=admin@flashvarta.com
PRIMARY_ADMIN_PASSWORD=use_a_strong_secret

# Allowed browser origin(s) for CORS, comma separated
CLIENT_URL=http://localhost:5173

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
SUBMISSION_FEE_INR=49

